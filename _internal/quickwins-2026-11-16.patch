diff --git a/website/script.js b/website/script.js
index 0511a47..4d74e6b 100644
--- a/website/script.js
+++ b/website/script.js
@@ -44,6 +44,16 @@ links.addEventListener("click", (e) => {
     toggle.setAttribute("aria-expanded", "false");
   }
 });
+// Escape closes the open menu. If focus was on one of its links, it goes back
+// to the menu button rather than staying on a hidden link.
+document.addEventListener("keydown", (e) => {
+  if (e.key !== "Escape" || !links.classList.contains("open")) return;
+  const focusInMenu = links.contains(document.activeElement);
+  links.classList.remove("open");
+  toggle.setAttribute("aria-expanded", "false");
+  toggle.setAttribute("aria-label", "Open menu");
+  if (focusInMenu) toggle.focus();
+});
 
 // Tabs (each tablist works on its own; arrow keys move between tabs, per the
 // WAI-ARIA tabs pattern)
diff --git a/website/styles.css b/website/styles.css
index 47bd72b..e1466a1 100644
--- a/website/styles.css
+++ b/website/styles.css
@@ -114,6 +114,8 @@ ul, ol { margin: 0; padding: 0; }
 .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
 .on-dark .text-link { color: var(--lime); }
 .band-lime .text-link { color: var(--forest); text-decoration: underline; text-underline-offset: 3px; }
+/* Leaf-deep is only 4.2:1 on lilac; forest is 8.5:1 */
+.band-lilac .text-link { color: var(--forest); }
 
 /* ───────── Header ───────── */
 .site-header {
@@ -213,6 +215,8 @@ ul, ol { margin: 0; padding: 0; }
 .page-hero-photo .bot { position: absolute; left: -26px; bottom: -30px; width: 108px; filter: var(--die-cut); transform: rotate(-8deg); }
 .page-hero-photo figcaption { font-size: 0.88rem; color: var(--on-forest-muted); margin-top: 12px; }
 .crumb { font: 600 1rem var(--head); color: var(--lime); margin-bottom: 12px; display: block; }
+/* The privacy page has no forest band, so its label sits on cream */
+.policy .crumb { color: var(--forest); }
 
 /* ───────── Numbers band ───────── */
 .numbers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
