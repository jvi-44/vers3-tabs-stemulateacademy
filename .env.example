# Copy this file to `.env` (same folder as package.json) and fill in your own
# values. `.env` is gitignored, so it stays on your computer and is never
# pushed to GitHub. Only this example file, with empty values, is committed.
# The server loads `.env` itself when it starts (see server/index.js).

# --- Server-only secrets: never give these a VITE_ prefix ---

# Passkey for the admin page (open the site and go to /#/admin).
# Use something long and hard to guess.
ADMIN_PASSKEY=

# Key for the "Ask the STEMbots" lesson helper (current Gemini version).
GEMINI_API_KEY=

# For the planned move to Supabase and Claude (see the setup guide):
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# Port for the API server (optional, defaults to 4000).
# PORT=4000

# --- Browser-side: Vite copies every VITE_ variable into the website ---
# Only the Supabase publishable key is safe here.
VITE_SUPABASE_PUBLISHABLE_KEY=
