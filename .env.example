# Copy this file to .env and fill in the values. .env is gitignored.
# The server loads it automatically via dotenv (see server/app.js).
# Never put any of these in frontend code — they are server-only.

# --- Gemini AI chat -------------------------------------------------
# Before adding a key, read DEPLOY.md "AI chat: decide first": Google's Gemini
# API terms don't allow services likely to be used by under-18s.
# Powers the "Ask about this lesson" STEMbot panel (POST /api/chat) and the
# website's "Ask us" assistant (POST /api/site/assistant).
# Get a key at https://aistudio.google.com/apikey — restrict it to the
# Generative Language API and set a low daily quota.
# Without this, both answer 503: the chat panel shows "STEMbots are resting
# right now" and the website's assistant (its button only shows with
# ASSISTANT_ON in website/script.js) says it isn't switched on yet.
# GEMINI_API (the name used on Render) works too.
GEMINI_API_KEY=

# Optional: a separate key (and quota) for the website's assistant, so a busy
# day on the public website can't use up the children's chat. Either key
# switches the website's assistant on, so "decide first" applies to both.
GEMINI_SITE_API_KEY=

# Optional: the website assistant's daily cap for everyone together (default
# 300), counted in the database per UTC day (from 8 a.m. Singapore time). 0
# keeps the website's assistant off even when GEMINI_API_KEY is set. Set a
# quota on Google's side as well (DEPLOY.md).
# ASSISTANT_DAILY_LIMIT=300

# Model used for the chat endpoint. Defaults to gemini-2.5-flash.
# Override here if you need a different model or tier.
GEMINI_MODEL=gemini-2.5-flash

# Tried when GEMINI_MODEL is out of quota (429) or overloaded (503). When both
# are out, the lesson chat answers with a hint from the lesson instead.
# "off" turns the fallback off.
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# --- Sessions -------------------------------------------------------
# Signs the httpOnly login cookie. Use 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random secret is generated at start-up, so everyone is
# signed out whenever the server restarts.
SESSION_SECRET=

# --- Admin page -----------------------------------------------------
# Passkey for the admin page (open the site and go to /#/admin). Use
# something long and hard to guess. Without it the passkey sign-in is off;
# staff accounts with the "admin" role still work (Admin page > Staff & volunteers).
ADMIN_PASSKEY=

# --- Server ---------------------------------------------------------
# The site's public URL (scheme + host, no trailing slash). Only this
# origin may call the API with the login cookie (CORS), staff sign-in and set-up
# links included, and every staff set-up link starts with it.
# Defaults to http://localhost:5173 (the Vite dev server).
APP_ORIGIN=

# --- Database ---------------------------------------------------------
# Students' data. On the host, set both of these to your Supabase project
# (Project Settings > API Keys): the project URL and a SECRET key, which starts
# sb_secret_. Never the publishable key: every table is locked to the server,
# so the server refuses to start with it. See DEPLOY.md.
# Leave both empty on your own computer to use the local database instead.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Folder for the local database (PGlite) when Supabase isn't set. Defaults to
# server/.pglite. In production the server needs Supabase, or DB_PATH pointing
# at a permanent disk.
DB_PATH=

# Port for the Express API. Defaults to 4000, which is what
# vite.config.ts proxies /api to in development.
PORT=4000

# Set to "production" on the host (secure cookies, trusts the host's proxy
# for client IPs, no stack traces).
# NODE_ENV=production

# Optional: per-address limit for sign-in, sign-up, Forgot PIN, admin passkey,
# staff sign-in and staff set-up requests per minute (default 20). Raise it if a
# whole centre shares one IP address.
# AUTH_RATE_LIMIT_PER_MIN=20

# On the host: where old /site links on the Academy's address redirect. Its
# address (with and without www) is also the only one whose pages may send the
# website's forms and assistant questions (SITE_ORIGINS, comma-separated,
# overrides that). On your own computer any localhost address may.
# WEBSITE_URL=https://projstemulate.com

# Optional caps for the website's sign-up forms: per address per 15 minutes
# (default 30; a class signing up after a school talk shares one address) and
# for everyone together per hour (default 200, counted in the database).
# Whole numbers from 1; anything else falls back to the default.
# SIGNUPS_PER_15_MIN=30
# SIGNUPS_PER_HOUR=200

# --- Not used yet ------------------------------------------------------
# For a planned switch of the lesson helper from Gemini to Claude.
ANTHROPIC_API_KEY=
AI_MODEL=

# The browser never talks to Supabase directly (every request goes through the
# server), so no Supabase key belongs in a VITE_ variable.
