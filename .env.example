# Copy this file to .env and fill in the values. .env is gitignored.
# The server loads it automatically via dotenv (see server/index.js).

# --- Gemini AI chat -------------------------------------------------
# Powers the "Ask about this lesson" STEMbot panel (POST /api/chat).
# Get a key at https://aistudio.google.com/apikey
# Without this, /api/chat returns 503 and the chat panel stays inert;
# the rest of the app works normally.
GEMINI_API_KEY=

# Model used for the chat endpoint. Defaults to gemini-2.5-flash.
# Override here if you need a different model or tier.
GEMINI_MODEL=gemini-2.5-flash

# --- Server ---------------------------------------------------------
# Port for the Express API. Defaults to 4000, which is what
# vite.config.ts proxies /api to in development.
PORT=4000
